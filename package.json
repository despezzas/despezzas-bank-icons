    "test": "npm run build && npm run test:pure && npm run test:react && npm run test:flutter"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "paper": "^0.12.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
